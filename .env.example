# ==============================================================================
# NEXO FINANCE — VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# ==============================================================================

# 1. FLAVOR INICIAL DO AMBIENTE
# Valores aceitos: DEV (Sandbox/Mock determinístico) | PROD (Integração Asaas + Open Finance)
NEXT_PUBLIC_APP_FLAVOR=DEV

# 2. FIREBASE AUTH & CLOUD FIRESTORE (Projeto oficial provisionado: nexo-eximiatech)
# Já embutido como default no código, mas você pode definir explicitamente na Vercel:
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCm7Xil_sjhSP7ITlN-aYLPq17_r2UXh4Q
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nexo-eximiatech.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nexo-eximiatech
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nexo-eximiatech.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=334002985649
NEXT_PUBLIC_FIREBASE_APP_ID=1:334002985649:web:b694b73b90a3830d26a090

# 3. ASAAS PIX GATEWAY (/api/asaas/pix)
# Onde obter: Painel Asaas (https://sandbox.asaas.com ou https://www.asaas.com)
# Menu: Configurações da Conta -> Integrações -> Gerar nova chave de API ($aact_...)
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=

# 4. OPEN FINANCE BRASIL — PLUGGY AGGREGATOR (/api/open-finance/sync)
# Onde obter (opcional): Painel Pluggy (https://dashboard.pluggy.ai -> Applications)
# Se não preenchido, o endpoint opera automaticamente em modo Sandbox Open Finance.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
