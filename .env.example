# ==============================================================================
# NEXO FINANCE — VARIÁVEIS DE AMBIENTE (VERCEL & LOCAL)
# ==============================================================================
# ATENÇÃO: NUNCA insira chaves reais neste arquivo. Copie para .env.local
# e preencha localmente ou configure no painel da Vercel.

# 1. FLAVOR INICIAL DO AMBIENTE
# Valores aceitos: DEV (Sandbox/Mock determinístico) | PROD (Integração Asaas + Open Finance)
NEXT_PUBLIC_APP_FLAVOR=DEV

# 2. FIREBASE AUTH & CLOUD FIRESTORE
NEXT_PUBLIC_FIREBASE_API_KEY=sua_firebase_api_key_aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# 3. ASAAS PIX GATEWAY & WEBHOOK (/api/asaas/pix e /api/webhooks/asaas)
# Onde obter: Painel Asaas -> Configurações -> Integrações -> Webhooks
# URL do Webhook na Produção: https://nexo.eximiatech.com.br/api/webhooks/asaas
ASAAS_BASE_URL=https://api.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# 4. OPEN FINANCE BRASIL — PLUGGY AGGREGATOR & WEBHOOK (/api/connect-token e /api/webhooks/pluggy)
# Onde obter: Painel Pluggy (https://dashboard.pluggy.ai -> Applications -> Webhooks)
# URL do Webhook na Produção: https://nexo.eximiatech.com.br/api/webhooks/pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
